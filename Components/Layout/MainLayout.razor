@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Routing

@* Phone-shaped shell: header / scrolling view / mini player / tab bar. Everything
   outside @Body renders statically (no render mode reaches the layout), so it is all
   plain JS — which is also what keeps it alive with no SignalR circuit. *@
<div class="app">
    <header class="app-head">
        <div class="logo">MM</div>
        <div class="head-main">
            @* Set by ui.js from the path: derived client-side so it's correct even when
               the page came from the service worker cache with no circuit. *@
            <div class="head-title" id="view-title">My Music</div>
            <div class="head-sub">
                <span class="head-dot"></span>
                <span id="offline-count">Checking this phone…</span>
            </div>
        </div>
        @* Plain JS, like everything else in this shell: syncing is exactly what you reach
           for when the circuit is unhealthy, so it must not depend on one. *@
        <button class="icon-btn" id="btn-sync" aria-label="Sync with server" title="Sync with server"
                onclick="ytdlSync()">⟳</button>
        <button class="icon-btn" id="btn-search" aria-label="Search" onclick="ytdlUI.toggleSearch()">⌕</button>
    </header>

    <div class="search-wrap" id="search-wrap" hidden>
        <input class="search-input" id="search-input" type="search" placeholder="Search your tracks"
               autocomplete="off" oninput="ytdlUI.onQuery(this.value)" />
    </div>

    <main class="app-main" id="app-main">
        <div id="offline-banner" class="offline-banner" hidden></div>
        @* playlist-offline.js reports the result of a sync here. Its own element rather
           than a JS-injected node, so it never sits inside the region Blazor diffs. *@
        <div id="sync-slot"></div>
        <div id="pwa-slot"></div>
        @Body
    </main>

    @* player.js mounts the mini player here so it sits above the tab bar rather than
       floating over the content. *@
    <div id="np-slot"></div>

    @* Two places to be, and one to return to. Adding a link is a thing you do occasionally
       and from the Library ("From YouTube"), so it no longer earns a permanent tab; what
       you almost always want back is whatever is playing. That middle button appears only
       when there IS something playing — body.has-np is set by player.js — so it is never
       a dead control. Plain JS, like every other control on the path to playback. *@
    <nav class="tabbar">
        <NavLink class="tab" href="" Match="NavLinkMatch.All">
            <span class="tab-i">≡</span><span class="tab-l">Playlists</span>
        </NavLink>
        <button type="button" class="tab tab-np" onclick="ytdlPlayer.openFull()">
            <span class="tab-i">♫</span><span class="tab-l">Playing</span>
        </button>
        <NavLink class="tab" href="library">
            <span class="tab-i">♪</span><span class="tab-l">Library</span>
        </NavLink>
    </nav>
</div>
