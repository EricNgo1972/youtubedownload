@page "/library"
@page "/history"
@rendermode InteractiveServer
@inject HistoryService Store
@inject UploadService Uploads

<PageTitle>Library</PageTitle>

@* Filter chips are client-side (offline/not-saved is Cache API state the server can't
   see), so ui.js drives them and filters rows by [data-off-for]. *@
<div class="chips">
    <button class="chip on" data-filter="all">All @_records.Count</button>
    <button class="chip" data-filter="offline">Offline <span data-count="offline">0</span></button>
    <button class="chip" data-filter="missing">Not saved <span data-count="missing">0</span></button>
    @if (_showArchived || _archivedCount > 0)
    {
        <button class="chip needs-circuit" @onclick="ToggleView">
            @(_showArchived ? "← Library" : $"Archived {_archivedCount}")
        </button>
    }
</div>

@if (!_showArchived)
{
    <div class="card needs-circuit">
        <div class="field-label">Add a track to your library</div>
        <div class="add-track-sources">
            <label class="add-source">
                <span class="add-source-title">⬆ Upload audio</span>
                <span class="hint">@UploadService.AllowedExtsLabel — from this device</span>
                <InputFile OnChange="OnUpload" multiple accept="audio/*" class="file-input" />
            </label>
            <a class="add-source" href="download">
                <span class="add-source-title">↓ From YouTube</span>
                <span class="hint">paste a link to download its audio</span>
            </a>
        </div>
        @if (_uploading)
        {
            <div class="upload-progress">
                <div class="upload-progress-head">
                    <span class="hint">Uploading @_uploadStage</span>
                    <span class="hint">@_uploadPct%@(_uploadTotal > 0 ? $" · {Mb(_uploadSent)} / {Mb(_uploadTotal)} MB" : "")</span>
                </div>
                <div class="bar"><div class="fill" style="width:@_uploadPct%"></div></div>
            </div>
        }
        @if (_uploadMsg is not null)
        {
            <div class="hint" style="margin-top:12px;color:var(--accent)">✓ @_uploadMsg</div>
        }
        @if (_uploadError is not null)
        {
            <div class="job-error" style="margin-top:12px">@_uploadError</div>
        }
    </div>
}

@if (_records.Count == 0)
{
    <div class="empty">
        <div class="empty-t">@(_showArchived ? "Nothing archived" : "Your library is empty")</div>
        <div class="empty-s">@(_showArchived ? "Archived tracks keep their files but stay out of the main list." : "Upload a track, or download one from a link.")</div>
    </div>
}
else
{
    <div class="empty" id="no-results" hidden>
        <div class="empty-t">Nothing matches</div>
        <div class="empty-s">Try a different search, or switch the filter above.</div>
    </div>

    <div id="lib-rows">
        @foreach (var r in _records)
        {
            var audioIndex = FirstAudioIndex(r);
            var trackUrl = audioIndex >= 0 ? $"/stream/{r.Id}/{audioIndex}" : null;
            <div class="trk" data-track-url="@trackUrl" data-title="@r.Title"
                 data-artist="@TrackVisuals.Artist(r.Author)"
                 data-share-id="@r.Id" data-share-title="@r.Title">
                <button class="trk-hit" onclick="ytdlPlayer.playEl(this)"
                        data-track-url="@trackUrl" data-title="@r.Title"
                        data-artist="@TrackVisuals.Artist(r.Author)" disabled="@(trackUrl is null)">
                    <span class="trk-art" style="background:@TrackVisuals.Tint(r.Id)">@TrackVisuals.Mono(r.Title)</span>
                    <span class="trk-main">
                        <span class="trk-title">@r.Title</span>
                        <span class="trk-sub">
                            @if (TrackVisuals.Artist(r.Author) is { Length: > 0 } a)
                            {
                                <span class="trk-artist">@a</span>
                                <span class="trk-dot">·</span>
                            }
                            <span class="trk-off" data-off-for="@trackUrl">…</span>
                            @if (LyricsService.Has(r))
                            {
                                <span class="trk-lrc" title="Lyrics available">LRC</span>
                            }
                        </span>
                    </span>
                    <span class="trk-dur">@TrackVisuals.Duration(r.Duration)</span>
                </button>
                <button class="trk-more" aria-label="More" onclick="ytdlUI.sheet(this)">⋯</button>

                @* Driven by the sheet — see the note in Playlists.razor. *@
                <span class="row-ops">
                    @if (_showArchived)
                    {
                        <button class="op-restore" @onclick="() => SetArchived(r.Id, false)"></button>
                    }
                    else
                    {
                        <button class="op-archive" @onclick="() => SetArchived(r.Id, true)"></button>
                    }
                </span>
                <span class="row-files" hidden>
                    @for (var i = 0; i < r.Files.Count; i++)
                    {
                        <a href="@($"files/{r.Id}/{i}")" download data-label="@FileLabel(r.Files[i])"></a>
                    }
                </span>
            </div>
        }
    </div>

    <div class="storage">
        <div class="eyebrow">On this phone</div>
        <div class="storage-bar"><div class="storage-fill" id="storage-fill"></div></div>
        <div class="storage-label" id="storage-label">Measuring…</div>
        @* Server build vs. what this device is actually running. A PWA caches hard, so
           these two can drift apart silently — showing both makes "why don't I see the
           new feature?" a five-second question instead of a debugging session. *@
        <div class="storage-label build-stamp">
            Server build @BuildInfo.Stamp · <span id="sw-version">checking cache…</span>
        </div>
    </div>
}

@code {
    private IReadOnlyList<DownloadRecord> _records = Array.Empty<DownloadRecord>();
    private bool _showArchived;
    private int _archivedCount;

    private bool _uploading;
    private string _uploadStage = "";
    private int _uploadPct;
    private long _uploadSent;
    private long _uploadTotal;
    private string? _uploadMsg;
    private string? _uploadError;

    private static string Mb(long bytes) => (bytes / 1024d / 1024d).ToString("0.0");

    // 500 MB per file — generous for long audio, well under a runaway.
    private const long MaxUploadBytes = 500L * 1024 * 1024;

    protected override void OnInitialized() => Reload();

    private void Reload()
    {
        _records = _showArchived ? Store.ArchivedItems() : Store.Active();
        _archivedCount = Store.ArchivedCount();
    }

    private void ToggleView()
    {
        _showArchived = !_showArchived;
        Reload();
    }

    private async Task SetArchived(string id, bool archived)
    {
        await Store.SetArchivedAsync(id, archived);
        Reload();
    }

    private async Task OnUpload(InputFileChangeEventArgs e)
    {
        _uploadError = null;
        _uploadMsg = null;
        _uploading = true;

        var files = e.GetMultipleFiles(maximumFileCount: 50);
        var added = 0;
        var errors = new List<string>();

        for (var i = 0; i < files.Count; i++)
        {
            var file = files[i];
            _uploadStage = files.Count > 1 ? $"{file.Name} ({i + 1}/{files.Count})" : file.Name;
            _uploadTotal = file.Size;
            _uploadSent = 0;
            _uploadPct = 0;
            await InvokeAsync(StateHasChanged);

            if (!UploadService.IsAllowed(file.Name))
            {
                errors.Add($"{file.Name}: unsupported type");
                continue;
            }
            try
            {
                // Progress<T> marshals its callback back to this component's sync
                // context, so re-rendering from it is safe. Only re-render when the
                // whole-number percent changes, to avoid flooding the circuit.
                var progress = new Progress<long>(sent =>
                {
                    _uploadSent = sent;
                    var pct = _uploadTotal > 0 ? (int)(sent * 100 / _uploadTotal) : 0;
                    if (pct != _uploadPct)
                    {
                        _uploadPct = pct;
                        StateHasChanged();
                    }
                });

                await using var stream = file.OpenReadStream(MaxUploadBytes);
                await Uploads.AddAsync(file.Name, stream, progress);
                added++;
            }
            catch (Exception ex)
            {
                errors.Add($"{file.Name}: {ex.Message}");
            }
        }

        _uploading = false;
        if (added > 0) _uploadMsg = $"Added {added} track{(added == 1 ? "" : "s")} to your library.";
        if (errors.Count > 0) _uploadError = string.Join(" · ", errors);
        Reload();
    }

    private static readonly string[] AudioExts = { ".mp3", ".m4a", ".webm", ".wav", ".ogg", ".oga", ".aac", ".flac" };

    /// <summary>Index of the first playable audio file in a record, or -1.</summary>
    private static int FirstAudioIndex(DownloadRecord r)
    {
        for (var i = 0; i < r.Files.Count; i++)
            if (AudioExts.Contains(Path.GetExtension(r.Files[i]).ToLowerInvariant()))
                return i;
        return -1;
    }

    private static string SourceLabel(TrackSource s) => s switch
    {
        TrackSource.Upload => "Upload",
        _ => "YouTube",
    };

    /// <summary>Short button label for a file, e.g. "MP4", "MP3", "SRT EN".</summary>
    private static string FileLabel(string path)
    {
        var ext = Path.GetExtension(path).TrimStart('.').ToUpperInvariant();
        if (ext == "SRT")
        {
            var stem = Path.GetFileNameWithoutExtension(path); // "Title.en"
            var dot = stem.LastIndexOf('.');
            if (dot >= 0) return $"SRT {stem[(dot + 1)..].ToUpperInvariant()}";
        }
        return ext;
    }
}
