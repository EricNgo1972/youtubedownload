@page "/download"
@rendermode InteractiveServer
@inject DownloadJobService Jobs
@inject HistoryService History
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Add music</PageTitle>

@* Two distinct steps, and conflating them misleads: this page fetches from YouTube onto
   the SERVER's library. Getting audio onto the phone is a second, separate action on the
   track itself (⋯ → Save to this phone). *@
@* Adding a link costs nothing — it stores the link, not the audio. That keeps this step
   instant even for a 200-video playlist, and means nothing is fetched for tracks you
   never actually listen to. *@
<div class="dl-intro">
    Paste a link and it lands in your library straight away — the link, not the audio, so
    it's instant even for a long playlist.
    <br /><br />
    The tracks then appear below. Tap <b>Download</b> on the ones you actually want: the
    server fetches the audio and your phone saves its own copy automatically. You can also
    do this later from <a href="library">Library</a>.
</div>

<div class="card">
    <input id="url" class="text-input" placeholder="Paste a video or playlist link"
           value="@_url" @oninput="OnUrlInput" />

    @if (_alreadyDownloaded)
    {
        <div class="hint hint-warn" style="margin-top:10px">✓ Already in your library.</div>
    }

    <div class="formats">
        <label class="chk"><input type="checkbox" @bind="_wantMp4" /> <span>Video (MP4)</span></label>
        <label class="chk"><input type="checkbox" @bind="_wantMp3" /> <span>Audio (MP3)</span></label>
        <label class="chk"><input type="checkbox" @bind="_wantSubs" /> <span>Subtitles</span></label>
    </div>

    @* A ten-hour audiobook at music quality is ~470 MB; as speech it's ~140 MB. On a phone
       that is the difference between fitting and not, and a narrator sounds the same. *@
    @if (_wantMp3)
    {
        <div class="playlist-opt">
            <label class="chk">
                <input type="checkbox" @bind="_wantSpoken" />
                <span>🎙 <strong>Audiobook / spoken word</strong> — mono, much smaller file
                    (about a quarter the size). Leave off for music.</span>
            </label>
        </div>
    }

    @if (_hasPlaylist && _hasVideo)
    {
        <div class="playlist-opt">
            <label class="chk">
                <input type="checkbox" @bind="_wantPlaylist" />
                <span>📃 This link has a playlist — download <strong>every</strong> video in it</span>
            </label>
        </div>
    }
    else if (_hasPlaylist)
    {
        <div class="playlist-opt">
            <span>📃 Playlist link — <strong>every</strong> video in it will be downloaded.</span>
        </div>
    }

    <div class="actions">
        <button class="btn" @onclick="AddLinks" disabled="@(!CanStart || _adding)">
            @(_adding ? "Adding…" : "Add to library")
        </button>
    </div>

    @if (_addError is not null)
    {
        <div class="hint hint-warn" style="margin-top:10px">⚠ @_addError</div>
    }
    else if (_addResult is not null)
    {
        <div class="hint" style="margin-top:10px">✓ @_addResult</div>
    }

    <div class="hint" style="margin-top:10px">
        Tip: leave <b>Subtitles</b> on — that's what the karaoke lyrics view reads. These
        choices are remembered per track and used when you download it.
    </div>
</div>

@* Everything you just added, right here with its Download button and its own progress.
   Adding, downloading and watching it happen were three different pages before, which
   made a single action feel like an errand. *@
@if (_added.Count > 0)
{
    <div class="row-between">
        <div class="eyebrow" style="margin-top:22px">Just added</div>
        @if (_added.Any(r => r.Pending && Jobs.FetchProgress(r.Id) is null))
        {
            <button class="btn-mini" @onclick="DownloadAll">Download all</button>
        }
    </div>

    <div class="card">
        @foreach (var r in _added)
        {
            var fetch = Jobs.FetchProgress(r.Id);
            <div class="trk">
                <span class="trk-art" style="background:@TrackVisuals.Tint(r.Id)">@TrackVisuals.Mono(r.Title)</span>
                <span class="trk-main">
                    <span class="trk-title">@r.Title</span>
                    <span class="trk-sub">
                        @if (!r.Pending)
                        {
                            <span class="trk-off on">Downloaded</span>
                        }
                        else if (fetch is { Active: true })
                        {
                            <span class="trk-off busy">@ShortStage(fetch)</span>
                        }
                        else if (fetch?.Error is { Length: > 0 } err)
                        {
                            <span class="trk-wait">@err</span>
                        }
                        else
                        {
                            @* No mode text here — these rows carry the tappable chip
                               instead, and saying it twice crowds the row. *@
                            <span class="trk-wait">Not downloaded</span>
                        }
                    </span>
                    @if (fetch is { Active: true })
                    {
                        @* span, not div: this sits inside .trk-main, which is a span. *@
                        <span class="bar" style="display:block;margin-top:6px"><span class="fill" style="display:block;width:@fetch.Percent%"></span></span>
                    }
                </span>
                @if (r.Pending && fetch is not { Active: true })
                {
                    <button class="mode-chip @(r.SpokenWord ? "on" : "")"
                            title="@(r.SpokenWord
                                ? "Audiobook: mono, small file. Tap for music quality."
                                : "Music quality. Tap for audiobook (about a quarter the size).")"
                            @onclick="() => ToggleSpoken(r.Id)">@(r.SpokenWord ? "🎙" : "♪")</button>
                    <button class="trk-get" @onclick="() => Fetch(r.Id)">
                        @(fetch?.Error is null ? "Download" : "Retry")
                    </button>
                }
            </div>
        }
    </div>
}

@if (_jobs.Count > 0)
{
    <div class="row-between">
        <div class="eyebrow" style="margin-top:22px">Queue</div>
        @if (_jobs.Any(j => !j.IsActive))
        {
            <button class="btn-mini" @onclick="ClearFinished">Clear finished</button>
        }
    </div>

    @foreach (var job in _jobs)
    {
        <div class="card job">
            <div class="job-head">
                <span class="badge badge-@job.Status.ToString().ToLowerInvariant()">@Badge(job)</span>
                <span class="job-stage">@job.Stage</span>
                @if (job.IsActive)
                {
                    <button class="btn-mini" @onclick="() => CancelJob(job)">@(job.IsPlaylist ? "Cancel all" : "Cancel")</button>
                }
            </div>

            @if (job.Status == JobStatus.Running && job.IsPlaylist)
            {
                <div class="bar job-overall"><div class="fill" style="width:@job.Percent%"></div></div>
            }

            @if (job.Items.Count > 0)
            {
                <ol class="job-items">
                    @foreach (var item in job.Items)
                    {
                        <li class="job-item">
                            @if (item.Skipped)
                            {
                                <span class="badge badge-skipped">Skipped</span>
                            }
                            else
                            {
                                <span class="badge badge-@item.Status.ToString().ToLowerInvariant()">@ItemStatus(item)</span>
                            }
                            <div class="job-item-main">
                                <div class="job-item-title">@(string.IsNullOrWhiteSpace(item.Title) ? "Loading title…" : item.Title)</div>
                                @if (item.Skipped)
                                {
                                    <div class="job-item-stage">Already in your Library</div>
                                }
                                else if (item.Status == JobStatus.Running)
                                {
                                    <div class="job-item-stage">@item.Stage · @item.Percent%</div>
                                    <div class="bar"><div class="fill" style="width:@item.Percent%"></div></div>
                                }
                                else if (item.Status == JobStatus.Paused)
                                {
                                    <div class="job-item-stage">Paused</div>
                                }
                                else if (item.Status == JobStatus.Failed && item.Error is not null)
                                {
                                    <div class="job-error">@item.Error</div>
                                }
                            </div>
                            <span class="job-item-ctl">
                                @if (item.Status is JobStatus.Running or JobStatus.Queued)
                                {
                                    <button class="btn-mini" title="Pause" @onclick="() => Pause(job, item)">⏸</button>
                                    <button class="btn-mini" title="Cancel" @onclick="() => CancelItem(job, item)">✕</button>
                                }
                                else if (item.Status == JobStatus.Paused)
                                {
                                    <button class="btn-mini" title="Resume" @onclick="() => Resume(job, item)">▶</button>
                                    <button class="btn-mini" title="Cancel" @onclick="() => CancelItem(job, item)">✕</button>
                                }
                                else
                                {
                                    <button class="btn-mini" title="Restart download" @onclick="() => Restart(job, item)">↻</button>
                                }
                            </span>
                        </li>
                    }
                </ol>
            }
            else if (job.Status == JobStatus.Running)
            {
                <div class="bar"><div class="fill" style="width:@job.Percent%"></div></div>
            }

            <div class="hint job-url">@job.Url</div>
            @if (job.Status == JobStatus.Failed && job.Error is not null)
            {
                <div class="job-error">@job.Error</div>
            }
            @if (job.RecordIds.Count > 0)
            {
                <a class="file-link" href="library">View in Library →</a>
            }
        </div>
    }
}

@code {
    private string _url = "";
    private bool _wantMp4 = false, _wantMp3 = true, _wantSubs = true;
    private bool _wantPlaylist, _hasPlaylist, _hasVideo, _alreadyDownloaded;
    private bool _wantSpoken;
    private bool _adding;
    private string? _addResult, _addError;
    private readonly List<DownloadRecord> _added = new();

    /// <summary>
    /// A short label for a row that is mid-download. The raw stage often IS the video's
    /// title (see DownloadOneAsync), which is already on the line directly above and long
    /// enough to push the row past the edge of the card — so anything long collapses to a
    /// plain word and the percent carries the actual information.
    /// </summary>
    private static string ShortStage(DownloadJobService.FetchState f)
    {
        var stage = f.Stage is { Length: > 0 and <= 24 } s ? s : "Downloading";
        return f.Percent > 0 ? $"{stage} · {f.Percent}%" : stage;
    }

    /// <summary>Start this track's download and tell the phone to keep it once it lands.
    /// One tap, from the same page that added it.</summary>
    private async Task Fetch(string id)
    {
        if (Jobs.EnqueueFetch(id) is null) return;
        try { await JS.InvokeVoidAsync("ytdlWantOnDevice", id); } catch { /* no JS yet */ }
        _jobs = Jobs.All().ToList();
        EnsurePolling();
    }

    /// <summary>Flip a not-yet-fetched track between music and audiobook quality.</summary>
    private Task ToggleSpoken(string id) =>
        History.UpdateAsync(id, r => r.SpokenWord = !r.SpokenWord);

    private async Task DownloadAll()
    {
        foreach (var r in _added.Where(r => r.Pending).ToList())
            await Fetch(r.Id);
    }

    private List<DownloadJob> _jobs = new();
    private PeriodicTimer? _timer;
    private Task? _pollTask;

    private bool CanStart => !string.IsNullOrWhiteSpace(_url) && (_wantMp4 || _wantMp3 || _wantSubs);

    protected override void OnInitialized()
    {
        RefreshUrlState();
        _jobs = Jobs.All().ToList();
    }

    private void OnUrlInput(ChangeEventArgs e)
    {
        _url = e.Value?.ToString() ?? "";
        RefreshUrlState();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) EnsurePolling();
    }

    private void RefreshUrlState()
    {
        var id = YoutubeDownloadService.TryGetVideoId(_url);
        _hasVideo = id is not null;
        _alreadyDownloaded = id is not null && History.Contains(id);
        _hasPlaylist = YoutubeDownloadService.HasPlaylist(_url);

        // A playlist-only URL (no single video) can only be a whole-playlist
        // download, so force it on. When there's also a video, leave it to the user.
        if (!_hasPlaylist) _wantPlaylist = false;
        else if (!_hasVideo) _wantPlaylist = true;
    }

    /// <summary>
    /// Adds the link to the library WITHOUT downloading. One metadata call resolves the
    /// URL — instant for a video, one listing for a playlist of any size — and each video
    /// becomes a pending track. The audio is pulled later, per track, from the Library.
    /// </summary>
    private async Task AddLinks()
    {
        if (!CanStart) return;
        _adding = true;
        _addError = null;
        _addResult = null;
        try
        {
            var (added, existing, updated) = await Jobs.AddLinksAsync(
                _url.Trim(), new DownloadOptions(_wantMp4, _wantMp3, _wantSubs, _wantPlaylist, _wantSpoken), CancellationToken.None);

            var fresh = added.Count - updated;
            _addResult = (fresh, updated, existing) switch
            {
                (0, 0, 0) => "Nothing to add for that link.",
                (0, 0, _) => $"Already downloaded ({existing} track{(existing == 1 ? "" : "s")}) — settings unchanged.",
                (0, _, _) => $"Already waiting to download — settings updated to {(_wantSpoken ? "audiobook" : "music")}.",
                (_, 0, 0) => $"Added {fresh} track{(fresh == 1 ? "" : "s")} — download what you want below.",
                _ => $"Added {fresh}, updated {updated}, skipped {existing} already downloaded.",
            };
            if (added.Count > 0)
            {
                // Newest first, and keep earlier additions so adding two links in a row
                // doesn't make the first batch disappear mid-download. Re-adding a link
                // moves that track back to the top rather than listing it twice.
                var ids = added.Select(r => r.Id).ToHashSet();
                _added.RemoveAll(r => ids.Contains(r.Id));
                _added.InsertRange(0, added);
                _url = "";
                RefreshUrlState();
            }
        }
        catch (Exception ex)
        {
            _addError = ex.Message;
        }
        finally
        {
            _adding = false;
        }
    }

    private void ClearFinished()
    {
        Jobs.ClearFinished();
        _jobs = Jobs.All().ToList();
    }

    // Poll the server for job status once a second while anything is active; stop
    // when idle, restart when a new job is queued. Survives tab reloads because
    // job state lives in the hosted service, not this component.
    private void EnsurePolling()
    {
        if (_pollTask is not null) return;
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _pollTask = PollLoop();
    }

    private async Task PollLoop()
    {
        try
        {
            while (_timer is not null && await _timer.WaitForNextTickAsync())
            {
                _jobs = Jobs.All().ToList();
                await InvokeAsync(StateHasChanged);
                if (!_jobs.Any(j => j.IsActive)) break;
            }
        }
        catch (OperationCanceledException) { }
        finally
        {
            _timer?.Dispose();
            _timer = null;
            _pollTask = null;
        }
    }

    private static string Badge(DownloadJob j) => j.Status switch
    {
        JobStatus.Queued => "Queued",
        JobStatus.Running => j.IsPlaylist ? $"{j.Percent}%" : $"{(j.Items.Count > 0 ? j.Items[0].Percent : j.Percent)}%",
        JobStatus.Completed => "Done",
        JobStatus.Failed => "Failed",
        JobStatus.Cancelled => "Cancelled",
        JobStatus.Paused => "Paused",
        _ => "",
    };

    private static string ItemStatus(DownloadItem it) => it.Status switch
    {
        JobStatus.Queued => "Queued",
        JobStatus.Running => "Downloading",
        JobStatus.Completed => "Completed",
        JobStatus.Failed => "Failed",
        JobStatus.Cancelled => "Cancelled",
        JobStatus.Paused => "Paused",
        _ => "",
    };

    private void CancelJob(DownloadJob job)   { Jobs.Cancel(job.Id);                  AfterControl(); }
    private void Pause(DownloadJob job, DownloadItem item)   { Jobs.PauseItem(job.Id, item.Id);   AfterControl(); }
    private void Resume(DownloadJob job, DownloadItem item)  { Jobs.ResumeItem(job.Id, item.Id);  AfterControl(); }
    private void CancelItem(DownloadJob job, DownloadItem item) { Jobs.CancelItem(job.Id, item.Id); AfterControl(); }
    private void Restart(DownloadJob job, DownloadItem item) { Jobs.RestartItem(job.Id, item.Id); AfterControl(); }

    // Refresh the snapshot and make sure the poll loop is running (a restart/resume can
    // revive a job that had already finished).
    private void AfterControl()
    {
        _jobs = Jobs.All().ToList();
        EnsurePolling();
    }

    public async ValueTask DisposeAsync()
    {
        _timer?.Dispose();
        _timer = null;
        if (_pollTask is not null)
        {
            try { await _pollTask; } catch { /* ignore */ }
        }
    }
}
